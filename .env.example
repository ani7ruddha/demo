# Creative Intelligence Dashboard — Environment Variables
# Copy this file to .env and fill in values as needed.
# Most settings can also be passed as CLI flags.

# ─── Browser ─────────────────────────────────────────────────────────────────
# Set to "true" to run Playwright in headless mode (no browser window)
CI_HEADLESS=true

# Path to a Chromium / Chrome executable (leave blank for Playwright's bundled Chromium)
CI_CHROMIUM_PATH=

# ─── Pipeline Defaults ────────────────────────────────────────────────────────
CI_MAX_ADS=300
CI_MIN_CLUSTER_SIZE=3

# ─── Embedding Model ──────────────────────────────────────────────────────────
# HuggingFace model ID for sentence-transformers
CI_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Data Paths ───────────────────────────────────────────────────────────────
CI_DATA_DIR=./data
